# Neo4j AuraDB Free - console.neo4j.io
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# SerpApi - serpapi.com/manage-api-key
SERPAPI_KEY=

# OpenWeatherMap - free tier key
OPENWEATHER_KEY=

# OpenJev - free hosted instance at Codiv (api.codiv.ai), or your own
# vLLM/MLX server (e.g. http://127.0.0.1:8080)
TYPESAFE_BASE_URL=https://api.codiv.ai
TYPESAFE_API_KEY=
