# Copy to .env and fill in for local dev. Never commit the real .env.

# --- internal auth ---
# Must match the value apps/api/src/clients/ai.ts sends as X-Internal-Key.
AI_INTERNAL_KEY=dev-internal-key

# --- infra (root AGENTS.md §2: infra/docker-compose.yml) ---
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# --- LLM providers (root AGENTS.md §3: Gemini primary, OpenAI/Grok fallback) ---
# Leave unset to run fully on deterministic fallbacks (no LLM calls made).
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
LLM_TIMEOUT_SECONDS=20

# --- SerpApi (root AGENTS.md §7) ---
# Leave USE_LIVE_APIS=false to run entirely against fixtures/serpapi/.
SERPAPI_KEY=
USE_LIVE_APIS=false
SERPAPI_FIXTURES_DIR=

# --- shared enums (root AGENTS.md §5) ---
# Leave unset to auto-detect packages/shared/enums by walking up from this
# file; only set this if services/ai is checked out outside the monorepo.
SHARED_ENUMS_DIR=
